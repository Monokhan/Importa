# Copia este archivo a .env y completa los valores. Nunca subas .env a GitHub.
# Frase secreta que se mezcla con cada contraseña. Si la pierdes, nadie podrá iniciar sesión.
IMPORTA_PEPPER=cambia-esto-por-una-frase-larga-y-secreta
# Ruta de la base de datos (en Docker se monta en /data)
IMPORTA_DB=importa.db
# Dominio público para HTTPS con Caddy (solo despliegue en servidor)
DOMINIO=app.tudominio.cl
